---
import { site, getWhatsAppUrl } from "../config/site";

const wa = getWhatsAppUrl(site.whatsappTexts.general);
const iconSize = 20;
---

<div class="flex items-center gap-2">
  <!-- WhatsApp -->
  <a class="icon-btn" href={wa} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <span class="sr-only">WhatsApp</span>
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 11.5a8.5 8.5 0 0 1-12.9 7.3L4 20l1.3-3.1A8.5 8.5 0 1 1 20 11.5Z"/>
      <path d="M9.5 9.5c.2 2 2.8 4.8 5 5l1.6-1.2c.3-.2.7-.2 1 0l1.5.8c.4.2.6.7.4 1.1-.6 1.2-2 1.8-3.2 1.5-3.1-.8-6.7-4.3-7.5-7.5-.3-1.2.3-2.6 1.5-3.2.4-.2.9 0 1.1.4l.8 1.5c.2.3.2.7 0 1L9.5 9.5Z"/>
    </svg>
  </a>

  <!-- Instagram -->
  <a class="icon-btn" href={site.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
    <span class="sr-only">Instagram</span>
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <path d="M16 11.8a4 4 0 1 1-7.9 1.2 4 4 0 0 1 7.9-1.2Z" />
      <path d="M17.5 6.5h.01" />
    </svg>
  </a>

  <!-- TikTok -->
  <a class="icon-btn" href={site.socials.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
    <span class="sr-only">TikTok</span>
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 3v10a4 4 0 1 1-4-4" />
      <path d="M14 7c1.5 2 3.5 3 6 3" />
    </svg>
  </a>
</div>
