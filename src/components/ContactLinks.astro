---
import { site, getWhatsAppUrl } from "../config/site";
import { getLangFromPath } from "../i18n/lang.ts";
import { t } from "../i18n/translations";

type Variant = "header" | "page";

const rawVariant = Astro.props.variant;
const variant: Variant = rawVariant === "page" ? "page" : "header";

const showLabels = Boolean(Astro.props.showLabels ?? false);

// Dışarıdan istenirse boyut ayarlanabilsin (NaN/negatif vs. olursa fallback)
const rawIconSize = Number(Astro.props.iconSize);
const iconSize =
  Number.isFinite(rawIconSize) && rawIconSize > 0
    ? rawIconSize
    : variant === "page"
      ? 22
      : 20;

// Dil tespiti
const lang = getLangFromPath(Astro.url.pathname);
const L = t(lang);

// ✅ WhatsApp linki: tek kaynak tercihimiz home.waText.general
// (Geriye dönük güvenlik: home yoksa faq.general)
const waText =
  L.home?.waText?.general ??
  L.faq?.waText?.general ??
  "Merhaba, Belgrad kurye danışmanlığı hakkında bilgi almak istiyorum.";

const wa = getWhatsAppUrl(waText);

// Boş link varsa ikon göstermeyelim
const instagram = site.socials.instagram?.trim() || undefined;
const tiktok = site.socials.tiktok?.trim() || undefined;

// ✅ Label’lar artık translations.ts içinden (social.*)
// (Geriye dönük fallback: cta.whatsapp veya sabit metin)
const labels = {
  whatsapp: L.social?.whatsapp ?? L.cta?.whatsapp ?? "WhatsApp",
  instagram: L.social?.instagram ?? "Instagram",
  tiktok: L.social?.tiktok ?? "TikTok",
};
---

<div class={variant === "page" ? "flex flex-col gap-2" : "flex items-center gap-2"}>
  <!-- WhatsApp -->
  <a
    class={variant === "page" ? "btn btn-ghost w-full justify-start gap-3" : "icon-btn"}
    href={wa}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.whatsapp}
    title={labels.whatsapp}
  >
    <svg
      style={`width:${iconSize}px;height:${iconSize}px`}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 11.5a8.5 8.5 0 0 1-12.9 7.3L4 20l1.3-3.1A8.5 8.5 0 1 1 20 11.5Z" />
      <path d="M9.5 9.5c.2 2 2.8 4.8 5 5l1.6-1.2c.3-.2.7-.2 1 0l1.5.8c.4.2.6.7.4 1.1-.6 1.2-2 1.8-3.2 1.5-3.1-.8-6.7-4.3-7.5-7.5-.3-1.2.3-2.6 1.5-3.2.4-.2.9 0 1.1.4l.8 1.5c.2.3.2.7 0 1L9.5 9.5Z" />
    </svg>
    {showLabels && <span class="text-sm">{labels.whatsapp}</span>}
    {!showLabels && <span class="sr-only">{labels.whatsapp}</span>}
  </a>

  <!-- Instagram -->
  {instagram && (
    <a
      class={variant === "page" ? "btn btn-ghost w-full justify-start gap-3" : "icon-btn"}
      href={instagram}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={labels.instagram}
      title={labels.instagram}
    >
      <svg
        style={`width:${iconSize}px;height:${iconSize}px`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <path d="M16 11.8a4 4 0 1 1-7.9 1.2 4 4 0 0 1 7.9-1.2Z" />
        <path d="M17.5 6.5h.01" />
      </svg>
      {showLabels && <span class="text-sm">{labels.instagram}</span>}
      {!showLabels && <span class="sr-only">{labels.instagram}</span>}
    </a>
  )}

  <!-- TikTok -->
  {tiktok && (
    <a
      class={variant === "page" ? "btn btn-ghost w-full justify-start gap-3" : "icon-btn"}
      href={tiktok}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={labels.tiktok}
      title={labels.tiktok}
    >
      <svg
        style={`width:${iconSize}px;height:${iconSize}px`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 3v10a4 4 0 1 1-4-4" />
        <path d="M14 7c1.5 2 3.5 3 6 3" />
      </svg>
      {showLabels && <span class="text-sm">{labels.tiktok}</span>}
      {!showLabels && <span class="sr-only">{labels.tiktok}</span>}
    </a>
  )}
</div>
