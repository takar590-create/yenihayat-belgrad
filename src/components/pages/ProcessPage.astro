---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, getWhatsAppUrl } from "../../config/site";

import { getLangFromPath, withLang, type Lang } from "../../i18n/lang.ts";
import { t } from "../../i18n/translations";

// ✅ Props öncelikli, yoksa path'ten tespit
const lang: Lang = (Astro.props.lang as Lang) ?? getLangFromPath(Astro.url.pathname);
const dict = t(lang);

// WhatsApp linkleri (dile göre metin)
const waGeneral = getWhatsAppUrl(dict.home.waText.general);
const waDocs = getWhatsAppUrl(dict.process.waText.docs);

// İç linkler (dile göre prefix)
const packagesHref = withLang("/paketler", lang);
const faqHref = withLang("/sss", lang);
const contactHref = withLang("/iletisim", lang);

// SEO
const pageTitle = `${dict.process.pageTitle} | ${site.brand}`;
---

<BaseLayout title={pageTitle} description={dict.process.metaDescription}>
  <section class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{dict.process.pageTitle}</h1>

    <p class="mt-1 text-zinc-700 max-w-2xl">
      {dict.process.lead}
    </p>

    <div class="mt-3 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
        {dict.process.buttons.startWhatsapp}
      </a>

      <a class="btn btn-ghost" href={waDocs} target="_blank" rel="noopener noreferrer">
        {dict.process.buttons.askDocs}
      </a>

      <a class="btn btn-ghost" href={packagesHref}>
        {dict.process.buttons.viewPackages}
      </a>
    </div>
  </section>

  <section class="mt-10">
    <div class="card p-6">
      <h2 class="text-xl font-bold">{dict.process.flow.title}</h2>
      <p class="mt-2 text-sm text-zinc-700">{dict.process.flow.desc}</p>
    </div>
  </section>

  <ol class="mt-6 space-y-4">
    {dict.process.steps.map((s, idx) => (
      <li class="card p-6">
        <p class="text-sm font-semibold text-zinc-500">
          {dict.process.stepLabel} {idx + 1}
        </p>
        <p class="mt-1 text-lg font-semibold">{s.t}</p>
        <p class="mt-2 text-sm text-zinc-700">{s.d}</p>
      </li>
    ))}
  </ol>

  <section class="mt-10 card p-6">
    <h2 class="text-xl font-bold">{dict.process.cta.title}</h2>
    <p class="mt-2 text-sm text-zinc-700">{dict.process.cta.desc}</p>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
        {dict.process.cta.btnWhatsapp}
      </a>
      <a class="btn btn-ghost" href={faqHref}>{dict.process.cta.btnFaq}</a>
      <a class="btn btn-ghost" href={contactHref}>{dict.process.cta.btnContact}</a>
    </div>
  </section>
</BaseLayout>
