---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, getWhatsAppUrl } from "../../config/site";

import { getLangFromPath, withLang, type Lang } from "../../i18n/lang.ts";
import { t } from "../../i18n/translations";

type Pkg = {
  id: string;
  title: string;
  price: string;
  highlight?: string;
  included: string[];
  notes?: string[];
  disclaimer?: string;
};

const lang: Lang = (Astro.props.lang as Lang) ?? getLangFromPath(Astro.url.pathname);
const dict = t(lang);

const packages = dict.packages.items as Pkg[];

const waGeneral = getWhatsAppUrl(dict.home.waText.general);

function tpl(s: string, vars: Record<string, string>) {
  return s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
}

function waForPackage(p: Pkg) {
  const text = tpl(dict.packages.waText.packageInterest, {
    city: site.city,
    title: p.title,
  });
  return getWhatsAppUrl(text);
}

const contactHref = withLang("/iletisim", lang);
const processHref = withLang("/surec", lang);

const pageTitle = `${dict.packages.pageTitle} | ${site.brand}`;
---

<BaseLayout title={pageTitle} description={dict.packages.metaDescription}>
  <section class="flex flex-col gap-3">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{dict.packages.pageTitle}</h1>

    <p class="text-zinc-700 max-w-2xl">
      {dict.packages.lead}
    </p>

    <div class="mt-3 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
        {dict.packages.buttons.askEligibility}
      </a>
      <a class="btn btn-ghost" href={contactHref}>{dict.packages.buttons.contact}</a>
    </div>
  </section>

  <section class="mt-10 grid gap-4 md:grid-cols-2">
    {packages.map((p) => (
      <div class={`card p-6 ${p.highlight ? "ring-1 ring-zinc-200" : ""}`} id={p.id}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-bold">{p.title}</p>
            {p.highlight ? (
              <p class="mt-1 text-xs text-zinc-600">
                <span class="badge">{p.highlight}</span>
              </p>
            ) : null}
          </div>

          <div class="text-right">
            <p class="text-xl font-bold">{p.price}</p>
            <p class="text-xs text-zinc-500">{dict.packages.priceNote}</p>
          </div>
        </div>

        <div class="mt-4">
          <p class="text-sm font-semibold">{dict.packages.labels.included}</p>
          <ul class="mt-3 space-y-2 text-sm text-zinc-700">
            {p.included.map((x) => (
              <li class="flex gap-2">
                <span class="mt-[2px] inline-block h-4 w-4 rounded-full border border-zinc-200 bg-zinc-50"></span>
                <span>{x}</span>
              </li>
            ))}
          </ul>
        </div>

        {p.notes ? (
          <div class="mt-5 rounded-xl border border-zinc-200 bg-zinc-50 p-4">
            <p class="text-sm font-semibold">{dict.packages.labels.notes}</p>
            <ul class="mt-2 space-y-1 text-sm text-zinc-700">
              {p.notes.map((n) => (
                <li>• {n}</li>
              ))}
            </ul>
          </div>
        ) : null}

        {p.disclaimer ? (
          <p class="mt-4 text-sm text-zinc-600">
            <span class="font-semibold">{dict.packages.labels.info}:</span> {p.disclaimer}
          </p>
        ) : null}

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-primary btn-3d" href={waForPackage(p)} target="_blank" rel="noopener noreferrer">
            {dict.packages.buttons.selectPackage}
          </a>
          <a class="btn btn-ghost" href={processHref}>{dict.packages.buttons.viewProcess}</a>
        </div>
      </div>
    ))}
  </section>

  <section class="mt-10 card p-6">
    <h2 class="text-xl font-bold">{dict.packages.importantNote.title}</h2>
    <p class="mt-2 text-sm text-zinc-700">{dict.packages.importantNote.desc}</p>
  </section>
</BaseLayout>
