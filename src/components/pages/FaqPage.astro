---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWhatsAppUrl } from "../../config/site";

import { getLangFromPath, type Lang } from "../../i18n/lang.ts";
import { t } from "../../i18n/translations";

type FAQ = {
  cat: string;
  q: string;
  a: string;
};

const lang: Lang = (Astro.props.lang as Lang) ?? getLangFromPath(Astro.url.pathname);
const dict = t(lang);

const waGeneral = getWhatsAppUrl(dict.faq.waText.general);
const waOffer = getWhatsAppUrl(dict.faq.waText.offer);
const waDocs = getWhatsAppUrl(dict.faq.waText.documents);

const faqs: FAQ[] = dict.faq.items;
const categories = Array.from(new Set(faqs.map((f) => f.cat)));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const strings = {
  noResults: dict.faq.search.noResults,
  resultsFound: dict.faq.search.resultsFound, // "{n} sonuç bulundu."
};

const catId = (c: string) => encodeURIComponent(c);
---

<BaseLayout title={dict.faq.pageTitle} description={dict.faq.metaDescription}>
  <section class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{dict.faq.heading}</h1>
    <p class="text-zinc-700 max-w-2xl">
      {dict.faq.intro}
    </p>

    <div class="mt-3 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
        {dict.faq.buttons.askEligibility}
      </a>
      <a class="btn btn-ghost" href={waOffer} target="_blank" rel="noopener noreferrer">
        {dict.faq.buttons.getOffer}
      </a>
      <a class="btn btn-ghost" href={waDocs} target="_blank" rel="noopener noreferrer">
        {dict.faq.buttons.requestDocs}
      </a>
    </div>
  </section>

  <!-- 🔎 Arama Kutusu -->
  <section class="mt-8">
    <div class="card p-6">
      <label for="faqSearch" class="font-semibold">{dict.faq.search.label}</label>
      <p class="mt-1 text-sm text-zinc-600">{dict.faq.search.help}</p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
        <input
          id="faqSearch"
          type="search"
          placeholder={dict.faq.search.placeholder}
          class="w-full rounded-xl border border-zinc-200 bg-white px-4 py-3 text-sm outline-none focus:border-zinc-400"
        />
        <button id="faqClear" class="btn btn-ghost sm:w-auto" type="button">{dict.faq.search.clear}</button>
      </div>

      <p id="faqCount" class="mt-3 text-sm text-zinc-600"></p>
    </div>
  </section>

  <section class="mt-10">
    <div class="card p-6">
      <p class="font-semibold">{dict.faq.topicsTitle}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {categories.map((c) => (
          <a class="badge hover:bg-zinc-100" href={`#${catId(c)}`}>{c}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ List -->
  <section class="mt-8 space-y-10" id="faqRoot">
    {categories.map((cat) => (
      <div class="faq-cat" data-cat={cat}>
        <h2 id={catId(cat)} class="text-xl font-bold">{cat}</h2>
        <div class="mt-4 space-y-4">
          {faqs
            .filter((f) => f.cat === cat)
            .map((f) => (
              <details class="card p-5 faq-item" data-q={f.q} data-a={f.a}>
                <summary class="cursor-pointer font-semibold faq-q">{f.q}</summary>
                <p class="mt-2 text-sm text-zinc-700 faq-a">{f.a}</p>
              </details>
            ))}
        </div>
      </div>
    ))}
  </section>

  <section class="mt-10 card p-6">
    <h2 class="text-xl font-bold">{dict.faq.quickNote.title}</h2>
    <p class="mt-2 text-sm text-zinc-700">{dict.faq.quickNote.desc}</p>
  </section>

  <style>
    mark.faq-mark {
      padding: 0.05em 0.2em;
      border-radius: 0.35em;
      background: rgba(34, 197, 94, 0.18);
    }
  </style>

  <script is:inline>
    {String.raw`
      const input = document.getElementById("faqSearch");
      const clearBtn = document.getElementById("faqClear");
      const countEl = document.getElementById("faqCount");

      const items = Array.from(document.querySelectorAll(".faq-item"));
      const cats = Array.from(document.querySelectorAll(".faq-cat"));

      const strings = ${JSON.stringify(strings)};

      // Orijinal metni sakla (highlight kaldırmak için)
      items.forEach((el) => {
        const qEl = el.querySelector(".faq-q");
        const aEl = el.querySelector(".faq-a");
        el.dataset.qOrig = qEl ? qEl.textContent : "";
        el.dataset.aOrig = aEl ? aEl.textContent : "";
      });

      function normalize(s) {
        return (s || "")
          .toLowerCase()
          .replaceAll("İ", "i").replaceAll("I", "i")
          .replaceAll("ı", "i").replaceAll("ş", "s")
          .replaceAll("ğ", "g").replaceAll("ü", "u")
          .replaceAll("ö", "o").replaceAll("ç", "c");
      }

      function escapeHtml(s) {
        return (s || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function highlightText(original, queryRaw) {
        const query = queryRaw.trim();
        if (!query) return escapeHtml(original);

        const safe = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        const re = new RegExp(safe, "gi");

        return escapeHtml(original).replace(re, (m) => \`<mark class="faq-mark">\${m}</mark>\`);
      }

      function applyFilter() {
        const raw = input.value.trim();
        const qNorm = normalize(raw);

        let visible = 0;

        items.forEach((el) => {
          const qOrig = el.dataset.qOrig || "";
          const aOrig = el.dataset.aOrig || "";

          const qN = normalize(qOrig);
          const aN = normalize(aOrig);

          const match = qNorm === "" || qN.includes(qNorm) || aN.includes(qNorm);

          el.style.display = match ? "" : "none";
          if (match) visible += 1;

          const qEl = el.querySelector(".faq-q");
          const aEl = el.querySelector(".faq-a");

          if (qEl && aEl) {
            if (qNorm === "") {
              qEl.textContent = qOrig;
              aEl.textContent = aOrig;
            } else if (match) {
              qEl.innerHTML = highlightText(qOrig, raw);
              aEl.innerHTML = highlightText(aOrig, raw);
            } else {
              qEl.textContent = qOrig;
              aEl.textContent = aOrig;
            }
          }
        });

        cats.forEach((catEl) => {
          const catItems = Array.from(catEl.querySelectorAll(".faq-item"));
          const anyVisible = catItems.some((x) => x.style.display !== "none");
          catEl.style.display = anyVisible ? "" : "none";
        });

        if (qNorm === "") {
          countEl.textContent = "";
        } else {
          countEl.textContent = visible === 0
            ? strings.noResults
            : strings.resultsFound.replace("{n}", String(visible));
        }
      }

      input.addEventListener("input", applyFilter);

      clearBtn.addEventListener("click", () => {
        input.value = "";
        applyFilter();
        input.focus();
      });

      applyFilter();
    `}
  </script>

  <script type="application/ld+json">
    {JSON.stringify(faqSchema)}
  </script>
</BaseLayout>
