---
import { site } from "../config/site";

const text = encodeURIComponent(site.whatsappTexts.general);
const wa = `https://wa.me/${site.whatsappNumber}?text=${text}`;
---

<a
  href={wa}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-4 right-4 z-50 rounded-full bg-zinc-900 px-4 py-3 text-sm font-semibold text-white shadow-lg hover:bg-zinc-800"
>
  WhatsApp’tan Yaz
</a>
