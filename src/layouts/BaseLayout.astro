---
import SeoHead from "../components/SeoHead.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import ContactLinks from "../components/ContactLinks.astro";
import "../styles/global.css";
import { site, getWhatsAppUrl } from "../config/site";

import { getLangFromPath, stripLangPrefix, withLang } from "../i18n/lang";
import { t } from "../i18n/translations";

const { title, description, canonical, noindex } = Astro.props;

// Dil tespiti
const lang = getLangFromPath(Astro.url.pathname);
const tr = t(lang);

// Brand linki: hangi dildeysen oranın anasayfasına gitsin
const homeHref = withLang("/", lang);

// Dil switch: aynı sayfada kalacak şekilde TR<->AZ
const basePath = stripLangPrefix(Astro.url.pathname);
const trHref = withLang(basePath, "tr");
const azHref = withLang(basePath, "az");

// ✅ Header WhatsApp linki (genel mesaj) — DİLE GÖRE
const waHeader = getWhatsAppUrl(tr.home.waText.general);

// Menü linkleri (dile göre prefix)
const navItems = [
  { href: "/hizmetler", label: tr.nav.services },
  { href: "/surec", label: tr.nav.process },
  { href: "/sss", label: tr.nav.faq },
  { href: "/blog", label: tr.nav.blog },
  { href: "/iletisim", label: tr.nav.contact },
  { href: "/paketler", label: tr.nav.packages },
].map((i) => ({
  ...i,
  href: withLang(i.href, lang),
}));

// CTA linki (dile göre)
const offerHref = withLang("/iletisim", lang);

// KVKK AZ yoksa TR link kalsın (AZ ekleyince withLang yaparız)
const kvkkHref = "/yasal/kvkk";
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={title} description={description} canonical={canonical} noindex={noindex} />
  </head>

  <body>
    <header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/80 backdrop-blur text-zinc-900">
      <div class="container flex items-center justify-between py-4">
        <a href={homeHref} class="text-base font-bold tracking-tight">{site.brand}</a>

        <!-- DESKTOP NAV -->
        <nav class="hidden gap-6 text-sm font-medium md:flex">
          {navItems.map((i) => (
            <a class="hover:text-zinc-700" href={i.href}>{i.label}</a>
          ))}
        </nav>

        <!-- DESKTOP SAĞ AKSİYONLAR -->
        <div class="hidden items-center gap-3 md:flex">
          <ContactLinks iconSize={18} />

          <!-- Dil -->
          <div class="flex items-center gap-2 text-xs text-zinc-700">
            <a class="rounded-lg border border-zinc-200 px-2 py-1 hover:bg-zinc-50" href={trHref}>TR</a>
            <a class="rounded-lg border border-zinc-200 px-2 py-1 hover:bg-zinc-50" href={azHref}>AZ</a>
          </div>

          <!-- Teklif Al -->
          <a href={offerHref} class="btn btn-primary btn-3d">{tr.cta.getOffer}</a>
        </div>

        <!-- MOBILE SAĞ AKSİYONLAR -->
        <div class="flex items-center gap-2 md:hidden">
          <ContactLinks iconSize={18} />
          <a href={offerHref} class="btn btn-primary btn-3d px-3 py-2 text-sm">{tr.cta.offerShort}</a>

          <button
            id="menuBtn"
            class="icon-btn"
            type="button"
            aria-label="Menüyü aç/kapat"
            aria-expanded="false"
            aria-controls="mobileMenu"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- MOBILE MENU -->
      <div id="mobileMenu" class="hidden border-t border-zinc-200 bg-white md:hidden">
        <div class="container py-4">
          <nav class="flex flex-col gap-3 text-sm font-medium">
            {navItems.map((i) => (
              <a class="hover:text-zinc-700 py-2" href={i.href}>{i.label}</a>
            ))}
          </nav>

          <div class="mt-4 flex items-center justify-between">
            <!-- Dil -->
            <div class="flex items-center gap-2 text-xs text-zinc-700">
              <a class="rounded-lg border border-zinc-200 px-2 py-1 hover:bg-zinc-50" href={trHref}>TR</a>
              <a class="rounded-lg border border-zinc-200 px-2 py-1 hover:bg-zinc-50" href={azHref}>AZ</a>
            </div>

            <!-- WhatsApp genel -->
            <a
              href={waHeader}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-zinc-200 px-3 py-2 text-xs hover:bg-zinc-50"
            >
              {tr.cta.whatsapp}
            </a>
          </div>
        </div>
      </div>

      <script is:inline>
        const btn = document.getElementById("menuBtn");
        const menu = document.getElementById("mobileMenu");
        if (btn && menu) {
          btn.addEventListener("click", () => {
            const isHidden = menu.classList.contains("hidden");
            menu.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", String(isHidden));
          });
        }
      </script>
    </header>

    <main class="container py-10">
      <slot />
    </main>

    <footer class="border-t border-zinc-200">
      <div class="container py-8 text-sm text-zinc-600">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <p>© {new Date().getFullYear()} {site.brand}</p>
          <div class="flex gap-4">
            <a class="hover:text-zinc-800" href={kvkkHref}>{tr.footer.kvkk}</a>
            <a class="hover:text-zinc-800" href={site.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
            <a class="hover:text-zinc-800" href={site.socials.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
          </div>
        </div>

        <p class="mt-4 text-xs text-zinc-500">
          {tr.footer.disclaimer}
        </p>
      </div>
    </footer>

    <WhatsAppFloat />
  </body>
</html>
