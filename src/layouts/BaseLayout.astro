---
import SeoHead from "../components/SeoHead.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import "../styles/global.css";
import { site, getWhatsAppUrl } from "../config/site";

const { title, description, canonical, noindex } = Astro.props;

// Header ikonundaki WhatsApp linki (genel mesaj)
const waHeader = getWhatsAppUrl(site.whatsappTexts.general);
---

<!doctype html>
<html lang="tr">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} noindex={noindex} />
  </head>
  <body>
    <header class="border-b border-zinc-200 bg-white/80 backdrop-blur">
      <div class="container flex items-center justify-between py-4">
        <a href="/" class="text-base font-bold tracking-tight">{site.brand}</a>

        <nav class="hidden gap-6 text-sm font-medium md:flex">
          <a class="hover:text-zinc-700" href="/hizmetler">Hizmetler</a>
          <a class="hover:text-zinc-700" href="/surec">Süreç</a>
          <a class="hover:text-zinc-700" href="/sss">SSS</a>
          <a class="hover:text-zinc-700" href="/blog">Blog</a>
          <a class="hover:text-zinc-700" href="/iletisim">İletişim</a>
          <a class="hover:text-zinc-700" href="/paketler">Paketler</a>
        </nav>

        <!-- SAĞ AKSİYONLAR: ikonlar + tek Teklif Al -->
        <div class="hidden items-center gap-3 md:flex">
          <!-- WhatsApp -->
          <a
            href={waHeader}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="WhatsApp"
            title="WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.52 3.48A11.9 11.9 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.33-1.65a11.86 11.86 0 0 0 5.73 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.43ZM12.06 21.8h-.01a9.9 9.9 0 0 1-5.04-1.37l-.36-.21-3.75.98 1-3.65-.24-.38A9.86 9.86 0 0 1 2.16 11.9C2.16 6.45 6.6 2 12.06 2a9.86 9.86 0 0 1 6.98 2.89 9.82 9.82 0 0 1 2.88 7.01c0 5.45-4.44 9.9-9.86 9.9Zm5.74-7.4c-.31-.16-1.86-.92-2.15-1.02-.29-.11-.5-.16-.71.16-.21.31-.81 1.02-.99 1.23-.18.21-.36.23-.67.08-.31-.16-1.29-.47-2.46-1.5-.91-.81-1.53-1.82-1.71-2.13-.18-.31-.02-.48.13-.64.14-.14.31-.36.47-.54.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.54-.08-.16-.71-1.71-.97-2.35-.26-.62-.52-.54-.71-.55l-.61-.01c-.21 0-.54.08-.83.39-.29.31-1.09 1.07-1.09 2.61 0 1.54 1.12 3.03 1.27 3.24.16.21 2.2 3.36 5.33 4.71.75.32 1.33.51 1.79.65.75.24 1.43.21 1.97.13.6-.09 1.86-.76 2.12-1.49.26-.73.26-1.36.18-1.49-.08-.13-.29-.21-.6-.36Z"
              />
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href={site.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="Instagram"
            title="Instagram"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm9 2h-9A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.6-2.65a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"
              />
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href={site.socials.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="TikTok"
            title="TikTok"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M16.7 3c.4 2.3 2 3.9 4.3 4.3v3.3c-1.5.1-2.9-.4-4.1-1.3v6.3c0 3.6-2.9 6.5-6.5 6.5S4 19.2 4 15.6s2.9-6.5 6.5-6.5c.3 0 .7 0 1 .1v3.6c-.3-.1-.6-.2-1-.2-1.6 0-3 1.3-3 3s1.3 3 3 3 3-1.3 3-3V3h3.2Z"
              />
            </svg>
          </a>

          <!-- SADECE 1 ADET "Teklif Al" (sağdaki kalsın) -->
          <a href="/iletisim" class="btn btn-primary btn-3d">Teklif Al</a>
        </div>
      </div>
    </header>

    <main class="container py-10">
      <slot />
    </main>

    <footer class="border-t border-zinc-200">
      <div class="container py-8 text-sm text-zinc-600">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <p>© {new Date().getFullYear()} {site.brand}</p>
          <div class="flex gap-4">
            <a class="hover:text-zinc-800" href="/yasal/kvkk">KVKK & Gizlilik</a>
            <a class="hover:text-zinc-800" href={site.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
            <a class="hover:text-zinc-800" href={site.socials.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
          </div>
        </div>
        <p class="mt-4 text-xs text-zinc-500">
          Bilgilendirme amaçlıdır. Resmî kurum değildir; süreç ve sonuçlar dosyaya göre değişebilir.
        </p>
      </div>
    </footer>

    <WhatsAppFloat />
  </body>
</html>
