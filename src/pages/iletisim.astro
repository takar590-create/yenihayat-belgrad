---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { site, getWhatsAppUrl } from "../config/site";
import { getLangFromPath } from "../i18n/lang";
import { t } from "../i18n/translations";

const lang = getLangFromPath(Astro.url.pathname);
const L = t(lang);

// WhatsApp metinleri: tek kaynak (faq.waText.*)
const waOffer = getWhatsAppUrl(L.faq.waText.offer);
const waDocs = getWhatsAppUrl(L.faq.waText.documents);
const waGeneral = getWhatsAppUrl(L.faq.waText.general);

// Sayfa metinleri (nested contact şeması)
const pageTitle = L.contact?.pageTitle ?? "İletişim";
const metaDescription =
  L.contact?.metaDescription ??
  "Belgrad kurye danışmanlığı için WhatsApp, Instagram ve TikTok üzerinden iletişime geçin.";

const heading = L.contact?.heading ?? pageTitle;

const intro =
  L.contact?.intro ??
  "En hızlı iletişim WhatsApp üzerinden. Sosyal medya hesaplarımızdan da bize ulaşabilirsin.";

const offerTitle = L.contact?.cards?.offer?.title ?? "Teklif almak için";
const offerDesc =
  L.contact?.cards?.offer?.desc ??
  "Araç tercihini (bisiklet/motor/araba) ve ne zaman gelebileceğini yaz.";
const offerBtn = L.contact?.cards?.offer?.btn ?? "WhatsApp’tan Teklif Al";

const docsTitle = L.contact?.cards?.docs?.title ?? "Evrak listesi";
const docsDesc =
  L.contact?.cards?.docs?.desc ?? "Gerekli evrak listesini iste, sana hızlıca gönderelim.";
const docsBtn = L.contact?.cards?.docs?.btn ?? "Evrak Listesi İste";

const eligibilityTitle = L.contact?.cards?.eligibility?.title ?? "Uygunluk kontrolü";
const eligibilityDesc =
  L.contact?.cards?.eligibility?.desc ?? "Kısa sorularla uygunluk ve yol haritası çıkaralım.";
const eligibilityBtn = L.contact?.cards?.eligibility?.btn ?? "Uygunluk Kontrolü";

const note = L.contact?.note ?? "Not: Bu site bilgilendirme amaçlıdır; resmî kurum değildir.";
---

<BaseLayout title={`${pageTitle} | ${site.brand}`} description={metaDescription}>
  <h1 class="text-2xl font-bold">{heading}</h1>
  <p class="mt-2 text-zinc-700">{intro}</p>

  <div class="mt-4">
    <ContactLinks variant="page" showLabels={true} />
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <div class="card p-6">
      <p class="font-semibold">{offerTitle}</p>
      <p class="mt-2 text-sm text-zinc-700">{offerDesc}</p>
      <a class="btn btn-primary mt-4 w-full" href={waOffer} target="_blank" rel="noopener noreferrer">
        {offerBtn}
      </a>
    </div>

    <div class="card p-6">
      <p class="font-semibold">{docsTitle}</p>
      <p class="mt-2 text-sm text-zinc-700">{docsDesc}</p>
      <a class="btn btn-ghost mt-4 w-full" href={waDocs} target="_blank" rel="noopener noreferrer">
        {docsBtn}
      </a>
    </div>

    <div class="card p-6">
      <p class="font-semibold">{eligibilityTitle}</p>
      <p class="mt-2 text-sm text-zinc-700">{eligibilityDesc}</p>
      <a class="btn btn-ghost mt-4 w-full" href={waGeneral} target="_blank" rel="noopener noreferrer">
        {eligibilityBtn}
      </a>
    </div>
  </div>

  <div class="mt-6 text-xs text-zinc-500">{note}</div>
</BaseLayout>
