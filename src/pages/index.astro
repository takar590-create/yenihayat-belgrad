---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, getWhatsAppUrl } from "../config/site";

const waGeneral = getWhatsAppUrl(site.whatsappTexts.general);
const waOffer = getWhatsAppUrl(site.whatsappTexts.offer);
---

<BaseLayout title={site.title} description={site.description}>
  <!-- HERO -->
  <section class="grid gap-8 md:grid-cols-2 md:items-center">
    <div>
      <span class="badge">Belgrad odaklı • WhatsApp ile hızlı iletişim</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
        Belgrad’da kurye olarak başlamak için uçtan uca danışmanlık
      </h1>
      <p class="mt-4 text-zinc-700">
        Şirket kuruluşu, oturum başvurusu, platform hesabı, araç ve konaklama desteği.
        Tüm süreç WhatsApp üzerinden şeffaf şekilde ilerler.
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
          WhatsApp’tan Hemen Yaz
        </a>
        <a class="btn btn-ghost" href="/surec">Süreç Nasıl İşliyor?</a>
      </div>

      <div class="mt-6 grid gap-3 md:grid-cols-3">
        <div class="card p-4">
          <p class="text-sm font-semibold">Hızlı Ön Değerlendirme</p>
          <p class="mt-1 text-sm text-zinc-600">2 dakikada uygunluk kontrolü.</p>
        </div>
        <div class="card p-4">
          <p class="text-sm font-semibold">Belgrad’da Yerel Ekip</p>
          <p class="mt-1 text-sm text-zinc-600">Sahada destek, yönlendirme.</p>
        </div>
        <div class="card p-4">
          <p class="text-sm font-semibold">Uçtan Uca Plan</p>
          <p class="mt-1 text-sm text-zinc-600">Şirket → oturum → işe başlangıç.</p>
        </div>
      </div>
    </div>

    <div class="card p-6">
      <p class="text-sm font-semibold">En çok sorulanlar</p>
      <ul class="mt-4 space-y-3 text-sm text-zinc-700">
        <li>• Şirket açılışı nasıl oluyor?</li>
        <li>• Oturum işlemleri ne kadar sürer?</li>
        <li>• Motor / bisiklet / araba: hangisi mantıklı?</li>
        <li>• Konaklama ve banka hesabı desteği var mı?</li>
      </ul>
      <a class="btn btn-primary mt-6 w-full" href="/sss">SSS’ye Git</a>
    </div>
  </section>

  <!-- HİZMETLER ÖZET -->
  <section class="mt-14">
    <h2 class="text-xl font-bold">Hizmetler</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {[
        { t: "Şirket Kuruluşu", d: "Belgrad’da şirket açılış süreci planlama ve koordinasyon." },
        { t: "Oturum Başvurusu", d: "Başvuru hazırlığı ve süreç takibi." },
        { t: "Glovo & Wolt Hesap Açılışı", d: "Şahsi hesap açılışı ve işe başlangıç planı." },
        { t: "Konaklama", d: "Hostel/ev seçenekleri, ilk gün planı." },
        { t: "Araç Desteği", d: "Bisiklet/motor/araba seçeneklerinin kıyaslanması." },
        { t: "Banka Hesabı", d: "Kişisel/şirket hesabı için adım adım yönlendirme." },
      ].map((x) => (
        <div class="card p-5">
          <p class="font-semibold">{x.t}</p>
          <p class="mt-2 text-sm text-zinc-600">{x.d}</p>
        </div>
      ))}
    </div>
    <a class="btn btn-ghost mt-6" href="/hizmetler">Tüm Hizmetleri Gör</a>
  </section>

  <!-- ✅ SÜREÇTEN TAŞINAN KARTLAR -->
  <section class="mt-14">
    <h2 class="text-xl font-bold">Aktivasyon ve ödeme düzeni</h2>
    <p class="mt-2 text-sm text-zinc-700">
      En çok sorulan iki konu: Glovo/Wolt aktivasyon takvimi ve ödemeler/kesintiler.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="card p-6">
        <h3 class="text-lg font-bold">Glovo / Wolt aktivasyon takvimi</h3>
        <ul class="mt-3 space-y-2 text-sm text-zinc-700">
          <li>
            • <span class="font-semibold">Wolt:</span> Pazar → Pazartesiye bağlayan güne kadar gönderilirse genelde
            <span class="font-semibold">Pazartesi aktif</span> edilir.
          </li>
          <li>
            • <span class="font-semibold">Glovo:</span> Başvurular genelde <span class="font-semibold">Çarşamba’ya kadar</span> aktif edilir.
          </li>
        </ul>
        <p class="mt-3 text-xs text-zinc-500">
          Not: Aktivasyon günleri dönemsel yoğunluğa göre değişebilir. En güncel takvimi WhatsApp’tan teyit ediyoruz.
        </p>
      </div>

      <div class="card p-6">
        <h3 class="text-lg font-bold">Ödeme düzeni ve kesintiler</h3>
        <ul class="mt-3 space-y-2 text-sm text-zinc-700">
          <li>• Acenta aylık kesinti: <span class="font-semibold">12.000 dinar</span></li>
          <li>• Glovo ödemeleri: <span class="font-semibold">haftalık</span></li>
          <li>• Wolt ödemeleri: <span class="font-semibold">15 günde 1</span></li>
          <li>• Glovo acente kesintisi: <span class="font-semibold">haftalık 3.000 dinar</span></li>
          <li>• Wolt acente kesintisi: <span class="font-semibold">15 günde 1, 6.000 dinar</span></li>
        </ul>
        <p class="mt-3 text-xs text-zinc-500">
          Not: Kesintiler/ödeme periyotları platform şartlarına göre değişebilir.
        </p>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-ghost" href="/surec">Süreç Sayfasında Detay</a>
      <a class="btn btn-primary btn-3d" href={waGeneral} target="_blank" rel="noopener noreferrer">
        WhatsApp’tan Sor
      </a>
    </div>
  </section>

  <!-- ✅ KAZANÇ ÖRNEKLERİ -->
  <section class="mt-14">
    <h2 class="text-xl font-bold">Kazanç örnekleri</h2>
    <p class="mt-2 text-sm text-zinc-700 max-w-3xl">
      Aşağıdaki rakamlar <span class="font-semibold">örnek senaryolardır</span>. Çalışma saati, bölge yoğunluğu,
      performans, bonus koşulları ve dönemsel şartlara göre değişebilir. En güncel planı WhatsApp’tan netleştiriyoruz.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <!-- WOLT -->
      <div class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-lg font-bold">Wolt (Araba / Motor)</h3>
          <span class="badge">e-bike bonus yok</span>
        </div>

        <ul class="mt-4 space-y-2 text-sm text-zinc-700">
          <li>• Günlük <span class="font-semibold">30 paket</span> → 6 günde <span class="font-semibold">180 paket</span> bonus hedefi</li>
          <li>• Haftalık bonus: <span class="font-semibold">18.000 dinar</span></li>
          <li>• En düşük paket ücreti: <span class="font-semibold">170 dinar</span></li>
          <li>• Cash paketler: <span class="font-semibold">100 paketten sonra</span> açılır ve paket kazancı <span class="font-semibold">2x</span> olabilir</li>
          <li>• Ortalama paket: <span class="font-semibold">230 dinar</span></li>
        </ul>

        <div class="mt-5 grid gap-3">
          <div class="card p-4">
            <p class="text-sm font-semibold">6 günlük örnek kazanç</p>
            <p class="mt-1 text-sm text-zinc-700">
              30 paket ≈ <span class="font-semibold">7.000 dinar/gün</span> → 6 günde ≈ <span class="font-semibold">41.400 dinar</span>
            </p>
            <p class="mt-1 text-sm text-zinc-700">
              Bonuslar eklenince ≈ <span class="font-semibold">61.400 dinar</span> (örnek: ~530€)
            </p>
          </div>

          <div class="card p-4">
            <p class="text-sm font-semibold">Aylık net (örnek)</p>
            <p class="mt-1 text-sm text-zinc-700">
              Yaklaşık <span class="font-semibold">2.200€</span> (en düşük paket sayısı + bahşiş yok varsayımı)
            </p>
          </div>
        </div>

        <a class="btn btn-primary btn-3d mt-5 w-full" href={waOffer} target="_blank" rel="noopener noreferrer">
          Bana göre kazanç planı çıkar
        </a>
      </div>

      <!-- GLOVO -->
      <div class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-lg font-bold">Glovo (Araba / Motor / e-bike)</h3>
          <span class="badge">Cash paket hemen</span>
        </div>

        <ul class="mt-4 space-y-2 text-sm text-zinc-700">
          <li>• Bonus hedefi: Araba/Motor <span class="font-semibold">205 paket</span></li>
          <li>• Bisiklet bonus hedefi: <span class="font-semibold">215 paket</span></li>
          <li>• Sabit en düşük ücret: <span class="font-semibold">yok</span></li>
          <li>• Cash paketler: <span class="font-semibold">başlar başlamaz</span></li>
          <li>• Ortalama paket: <span class="font-semibold">240 dinar</span></li>
          <li>• Haftalık bonus: <span class="font-semibold">20.000 dinar</span></li>
        </ul>

        <div class="mt-5 grid gap-3">
          <div class="card p-4">
            <p class="text-sm font-semibold">6 günlük örnek kazanç</p>
            <p class="mt-1 text-sm text-zinc-700">
              34 paket ≈ <span class="font-semibold">8.200 dinar/gün</span> → 6 günde ≈ <span class="font-semibold">49.000 dinar</span>
            </p>
            <p class="mt-1 text-sm text-zinc-700">
              Hafta sonu bonusu + çarpanlı saatlerle ≈ <span class="font-semibold">600€</span> seviyesine çıkabilir
            </p>
          </div>

          <div class="card p-4">
            <p class="text-sm font-semibold">Aylık net (örnek)</p>
            <p class="mt-1 text-sm text-zinc-700">
              Yaklaşık <span class="font-semibold">2.400€</span> (örnek: günlük ~12 saat çalışma varsayımı)
            </p>
          </div>
        </div>

        <a class="btn btn-primary btn-3d mt-5 w-full" href={waOffer} target="_blank" rel="noopener noreferrer">
          Bana göre kazanç planı çıkar
        </a>
      </div>
    </div>

    <p class="mt-4 text-xs text-zinc-500">
      Uyarı: Rakamlar bilgilendirme amaçlıdır. Kazanç; bölge, saat, yoğunluk, bonus şartları, performans ve platform politikalarına göre değişir.
    </p>
  </section>

  <!-- ✅ PAKETLER ÖNİZLEME (EN UCUZ 2 PAKET) -->
  <section class="mt-14">
    <h2 class="text-xl font-bold">Paketler</h2>
    <p class="mt-2 text-sm text-zinc-700">
      En çok tercih edilen seçeneklerden (en uygun 2 paket) — detaylar ve kapsam için paketler sayfasına geçebilirsin.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <!-- Paket 3 -->
      <div class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-lg font-bold">Paket 3</p>
          <p class="text-lg font-bold">450€</p>
        </div>
        <p class="mt-1 text-sm text-zinc-600">Uygun fiyatlı temel paket.</p>
        <ul class="mt-4 space-y-2 text-sm text-zinc-700">
          <li>• Avukatlık ücretleri</li>
          <li>• Şirket açılışı</li>
          <li>• Oturum başvurusu</li>
          <li>• Banka hesap açılışları</li>
          <li>• Havaalanı karşılama</li>
        </ul>
      </div>

      <!-- Paket 2 -->
      <div class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-lg font-bold">Paket 2</p>
          <p class="text-lg font-bold">700€</p>
        </div>
        <p class="mt-1 text-sm text-zinc-600">Şirket + oturum odaklı.</p>
        <ul class="mt-4 space-y-2 text-sm text-zinc-700">
          <li>• Avukatlık ücretleri</li>
          <li>• Şirket açılışı</li>
          <li>• Oturum başvurusu</li>
          <li>• Yasal harçlar</li>
        </ul>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href="/paketler">Paketlere Git</a>
      <a class="btn btn-ghost" href={waOffer} target="_blank" rel="noopener noreferrer">
        WhatsApp’tan Teklif Al
      </a>
    </div>

    <p class="mt-3 text-xs text-zinc-500">
      Not: Kapsam ve resmi ücretler dosyaya göre değişebilir. En doğru teklif için WhatsApp’tan kısa bilgi alıyoruz.
    </p>
  </section>

  <!-- TEKLİF -->
  <section class="mt-14 card p-6">
    <h2 class="text-xl font-bold">Teklif al</h2>
    <p class="mt-2 text-sm text-zinc-700">
      Fiyatlar dosyaya göre değişir. En doğru teklif için WhatsApp’tan kısa bilgi paylaşman yeterli.
    </p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary btn-3d" href={waOffer} target="_blank" rel="noopener noreferrer">
        WhatsApp’tan Teklif Al
      </a>
      <a class="btn btn-ghost" href="/iletisim">İletişim Sayfası</a>
    </div>
  </section>
</BaseLayout>
