---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../config/site";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;

// Markdown/MDX içerik render
const { Content } = await post.render();

const waText = encodeURIComponent(
  `Salam, bu yazı barədə sual vermək istəyirəm: "${post.data.title}".`
);
const wa = `https://wa.me/${site.whatsappNumber}?text=${waText}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: "az-AZ",
};
---

<BaseLayout title={`${post.data.title} | ${site.brand}`} description={post.data.description}>
  <article class="prose max-w-none">
    <h1>{post.data.title}</h1>
    <p class="text-sm text-zinc-500">
      {post.data.pubDate.toLocaleDateString("az-AZ")}
    </p>

    <div class="mt-6">
      <Content />
    </div>
  </article>

  <div class="mt-10 card p-6">
    <p class="font-semibold">Bu mövzuda tez cavab istəyirsən?</p>
    <p class="mt-2 text-sm text-zinc-700">WhatsApp-dan yaz, sənədinə görə dəqiqləşdirək.</p>
    <a class="btn btn-primary mt-4" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp-dan soruş</a>
  </div>

  <script type="application/ld+json">
    {JSON.stringify(articleSchema)}
  </script>
</BaseLayout>
